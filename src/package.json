{
  "name": "src",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:visual-parity": "node scripts/run-vite-module.mjs src/componentVisualParityCorpus.ts",
    "validate:component-specs": "node ../scripts/validate-component-specs.mjs",
    "check:coordinates-seam": "node ../scripts/check-coordinates-seam.mjs",
    "diagnose:visuals": "node ../scripts/component-visual-diagnostics.js",
    "measure:mesh-extents": "node ../scripts/measure-mesh-extents.mjs",
    "check:mesh-extents": "node ../scripts/measure-mesh-extents.mjs --strict",
    "preset:check": "node ../scripts/preset-check.mjs",
    "install-hooks": "git -C .. config core.hooksPath .githooks",
    "test:rotation-parity": "node --experimental-strip-types src/rotationParityCorpus.ts",
    "test:rotation-parity-py": "pushd .. && python -m core.sim.tests.test_rotation_parity && popd",
    "test:collision-envelope-py": "pushd .. && python -m core.sim.tests.test_collision_envelope && popd",
    "test:quadruped-contact-py": "pushd .. && python -m core.sim.tests.test_quadruped_contact && popd",
    "check": "npm run validate:component-specs && npm run check:catalog-sim-fields && npm run check:coordinates-seam && tsc --noEmit && npm run test:visual-parity && npm run check:mesh-extents && npm run test:rotation-parity && npm run test:rotation-parity-py && npm run test:collision-envelope-py && npm run test:quadruped-contact-py && npm run test:designer && npm run test:controllers && npm run test:catalog-physics-py",
    "test:designer": "pushd .. && python -m core.designer.test_designer && popd",
    "test:controllers": "pushd .. && python -m core.sim.tests.test_controllers && popd",
    "test:catalog-physics-py": "pushd .. && python -m core.sim.tests.test_catalog_physics && popd",
    "check:catalog-sim-fields": "pushd .. && python scripts/add_catalog_sim_fields.py --check && popd"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@types/three": "^0.183.1",
    "monaco-editor": "^0.55.1",
    "occt-import-js": "^0.0.23",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "replicad-threejs-helper": "^0.23.0",
    "three": "^0.183.2"
  }
}
