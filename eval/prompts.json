{
  "version": 1,
  "description": "Fixed prompt set for the generation-quality eval harness (scripts/eval_generation.py). Expectations drive the structure metric; keep prompts stable so before/after comparisons stay meaningful.",
  "prompts": [
    {
      "id": "dog",
      "prompt": "build me a robot dog",
      "dof_range": [8, 14],
      "min_legs": 4,
      "max_legs": 4,
      "expect_wheels": false,
      "expect_symmetry": true,
      "expect_ground_contact": true
    },
    {
      "id": "humanoid",
      "prompt": "build a humanoid robot with two arms, two legs, and a head camera",
      "dof_range": [10, 22],
      "min_legs": 2,
      "max_legs": 2,
      "expect_wheels": false,
      "expect_symmetry": true,
      "expect_ground_contact": true,
      "passive_stable": false
    },
    {
      "id": "hexapod",
      "prompt": "build a six-legged insect robot with antennae sensors and varied leg poses",
      "dof_range": [12, 24],
      "min_legs": 6,
      "max_legs": 6,
      "expect_wheels": false,
      "expect_symmetry": true,
      "expect_ground_contact": true
    },
    {
      "id": "rover",
      "prompt": "build a four-wheeled rover with a front camera and a battery",
      "dof_range": [4, 8],
      "min_wheels": 4,
      "max_wheels": 4,
      "expect_wheels": true,
      "expect_symmetry": true,
      "expect_ground_contact": true
    },
    {
      "id": "arm",
      "prompt": "build a tabletop robotic arm with a gripper",
      "dof_range": [3, 7],
      "expect_wheels": false,
      "expect_symmetry": false,
      "expect_ground_contact": true
    },
    {
      "id": "sculpture",
      "prompt": "build a scorpion robot with a curled articulated tail, two pincer claws, and six walking legs",
      "dof_range": [14, 32],
      "min_legs": 6,
      "expect_wheels": false,
      "expect_symmetry": true,
      "expect_ground_contact": true
    }
  ]
}
