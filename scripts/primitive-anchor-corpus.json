{
  "description": "Shared TS/Python parity fixtures for primitive-anchor resolution (WS5). Each case names a primitive, an anchor, and the expected link-frame origin (mm) + outward axis. Both runners (src/src/primitiveAnchorCorpus.ts, core/sim/tests/test_anchor_parity.py) must match within 1e-6.",
  "cases": [
    {
      "name": "box +z_face, unrotated, offset center",
      "primitive": { "name": "chest", "shape": "box", "size_mm": [180, 100, 260], "xyz_mm": [0, 0, 130] },
      "anchor": "+z_face",
      "origin_xyz_mm": [0, 0, 260],
      "axis_xyz": [0, 0, 1]
    },
    {
      "name": "box -x_face, yawed 90deg (local -x becomes link -y)",
      "primitive": { "name": "seg", "shape": "box", "size_mm": [100, 40, 40], "xyz_mm": [10, 20, 30], "rpy": [0, 0, 1.5707963267948966] },
      "anchor": "-x_face",
      "origin_xyz_mm": [10, -30, 30],
      "axis_xyz": [0, -1, 0]
    },
    {
      "name": "cylinder +axis_end, rolled 90deg about x (axis -> -y)",
      "primitive": { "name": "shoulder_l", "shape": "cylinder", "radius_mm": 25, "length_mm": 60, "xyz_mm": [0, -115, 230], "rpy": [1.5707963267948966, 0, 0] },
      "anchor": "+axis_end",
      "origin_xyz_mm": [0, -145, 230],
      "axis_xyz": [0, -1, 0]
    },
    {
      "name": "cylinder -axis_end, rolled 90deg about x",
      "primitive": { "name": "shoulder_l2", "shape": "cylinder", "radius_mm": 25, "length_mm": 60, "xyz_mm": [0, -115, 230], "rpy": [1.5707963267948966, 0, 0] },
      "anchor": "-axis_end",
      "origin_xyz_mm": [0, -85, 230],
      "axis_xyz": [0, 1, 0]
    },
    {
      "name": "cylinder tangent_+x, unrotated vertical cylinder",
      "primitive": { "name": "mast", "shape": "cylinder", "radius_mm": 30, "length_mm": 200, "xyz_mm": [5, 5, 100] },
      "anchor": "tangent_+x",
      "origin_xyz_mm": [35, 5, 100],
      "axis_xyz": [1, 0, 0]
    },
    {
      "name": "cylinder tangent_+z on a rolled cylinder (axis -y): radial projection",
      "primitive": { "name": "barrel", "shape": "cylinder", "radius_mm": 40, "length_mm": 120, "xyz_mm": [0, 0, 50], "rpy": [1.5707963267948966, 0, 0] },
      "anchor": "tangent_+z",
      "origin_xyz_mm": [0, 0, 90],
      "axis_xyz": [0, 0, 1]
    },
    {
      "name": "sphere +z_pole",
      "primitive": { "name": "head", "shape": "sphere", "radius_mm": 70, "xyz_mm": [0, 0, 330] },
      "anchor": "+z_pole",
      "origin_xyz_mm": [0, 0, 400],
      "axis_xyz": [0, 0, 1]
    },
    {
      "name": "sphere -x_pole, rpy on sphere ignored",
      "primitive": { "name": "eye", "shape": "sphere", "radius_mm": 10, "xyz_mm": [50, 0, 20], "rpy": [0.4, 0.5, 0.6] },
      "anchor": "-x_pole",
      "origin_xyz_mm": [40, 0, 20],
      "axis_xyz": [-1, 0, 0]
    }
  ],
  "invalid_cases": [
    {
      "name": "cylinder tangent parallel to axis is undefined",
      "primitive": { "name": "mast2", "shape": "cylinder", "radius_mm": 30, "length_mm": 200 },
      "anchor": "tangent_+z"
    },
    {
      "name": "box pole anchor is invalid",
      "primitive": { "name": "block", "shape": "box", "size_mm": [10, 10, 10] },
      "anchor": "+z_pole"
    }
  ]
}
